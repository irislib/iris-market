#!/usr/bin/env bash
# Writes the town names the Rust core uses to name public areas, from the web place labels
# (Natural Earth public-domain data). Rerun after web/src/places/labels.json changes.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
python3 - "$root/web/src/places/labels.json" "$root/crates/market-core/data/towns.tsv" <<'PY'
import json, sys
labels = json.load(open(sys.argv[1], encoding='utf-8'))['labels']
rows = sorted((p for p in labels if p.get('kind') == 'city'), key=lambda p: (p['name'], p['lat'], p['lng']))
with open(sys.argv[2], 'w', encoding='utf-8', newline='\n') as out:
    out.write('# Natural Earth public-domain populated places: name, latitude, longitude, population. Generated by scripts/sync-towns.\n')
    for p in rows:
        name = p['name'].replace('\t', ' ').replace('\n', ' ')
        out.write(f"{name}\t{p['lat']:.4f}\t{p['lng']:.4f}\t{max(0, int(p.get('population') or 0))}\n")
print(f'{len(rows)} towns')
PY
