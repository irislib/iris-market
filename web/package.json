{
  "name": "iris-market-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "npm run check && vite build && vite build --mode downloads",
    "test": "node --test tests/*.test.js",
    "test:built-graph": "node --test scripts/check-built-graph.mjs",
    "dev": "vite",
    "demo:transport": "node scripts/demo/server.ts",
    "demo:public": "node scripts/demo/public-server.ts",
    "demo:public-service": "node scripts/demo/service.ts --public",
    "demo:service": "node scripts/demo/service.ts",
    "check": "tsc --noEmit",
    "preview": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@cashu/cashu-ts": "4.13.0",
    "@hashtree/core": "https://github.com/mmalmi/hashtree/releases/download/hashtree-ts-runtime-v0.5.27/hashtree-core-0.4.0.tgz",
    "@hashtree/dexie": "https://github.com/mmalmi/hashtree/releases/download/hashtree-ts-runtime-v0.5.27/hashtree-dexie-0.1.13.tgz",
    "@hashtree/index": "https://github.com/mmalmi/hashtree/releases/download/hashtree-ts-runtime-v0.5.27/hashtree-index-0.1.15.tgz",
    "@hashtree/nostr": "https://github.com/mmalmi/hashtree/releases/download/hashtree-ts-runtime-v0.5.27/hashtree-nostr-0.2.6.tgz",
    "@hashtree/nostr-pubsub": "https://github.com/mmalmi/hashtree/releases/download/hashtree-ts-runtime-v0.5.27/hashtree-nostr-pubsub-0.1.9.tgz",
    "@hashtree/worker": "https://github.com/mmalmi/hashtree/releases/download/hashtree-ts-runtime-v0.5.28/hashtree-worker-0.4.18.tgz",
    "@huggingface/transformers": "4.3.2",
    "@noble/hashes": "2.0.1",
    "maplibre-gl": "6.15.0",
    "marked": "15.0.12",
    "minidenticons": "4.2.1",
    "nostr-double-ratchet": "0.0.183",
    "nostr-pubsub": "https://github.com/mmalmi/nostr-pubsub/releases/download/nostr-pubsub-ts-v0.5.21/nostr-pubsub-0.5.21.tgz",
    "nostr-social-graph": "https://github.com/mmalmi/nostr-social-graph/releases/download/v4.0.1/nostr-social-graph-4.0.1.tgz",
    "nostr-tools": "2.25.2",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "pmtiles": "4.4.1",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "wrangler": "4.154.0"
  },
  "overrides": {
    "nostr-pubsub": "$nostr-pubsub",
    "nostr-tools": "$nostr-tools"
  }
}
